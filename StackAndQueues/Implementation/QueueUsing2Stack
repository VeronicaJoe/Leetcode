class MyQueue1 {
    Stack<Integer> s1;
    Stack<Integer> s2;
    public MyQueue1() 
    {
        s1 = new Stack<>();
        s2 = new Stack<>();
    }
    
    public void push(int x) 
    {
        s1.push(x);
    }
    
    public int pop() 
    {
        //Is s2 is empty then remove all elements from s1->s2
        if(empty())
        return -1;
        if(s2.isEmpty())
        {
            while(!s1.isEmpty())
            {
                s2.push(s1.pop());
            }
        }
        return s2.pop();
    }
    
    public int peek() 
    {
        if(empty())
        return -1;
        if(s2.isEmpty())
        {
            while(!s1.isEmpty())
            {
                s2.push(s1.pop());
            }
        }
        return s2.peek();   
    }
    
    public boolean empty()
    {
        return s1.isEmpty()&&s2.isEmpty();
    }
}
//Performing operations in the push itself 
class MyQueue {
    Stack<Integer> s1;
    Stack<Integer> s2;
    public MyQueue() 
    {
        s1 = new Stack<>();
        s2 = new Stack<>();
    }
    
    public void push(int x) 
    {
        
        //Step 1: Move s1 -> s2
        while(!s1.isEmpty())
        {
            s2.push(s1.pop());
        }
        //Step 2: Add to s1
        s1.push(x);
        //Step 3: Move s2 -> s1
        while(!s2.isEmpty())
        {
            s1.push(s2.pop());
        }
    }
    
    public int pop() 
    {
       if(empty())
       return -1;
       return s1.pop();
    }
    
    public int peek() 
    {
       if(empty())
       return -1;
       return s1.peek();
    }
    
    public boolean empty()
    {
        return s1.isEmpty();
    }
}


